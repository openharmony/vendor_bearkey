allow riladapter_host sys_file:file { read open };
allow riladapter_host tty_device:chr_file { ioctl };
allow riladapter_host hiviewdfx_hiview_param:file { read open };
allow riladapter_host paramservice_socket:sock_file { write };
allow riladapter_host kernel:unix_stream_socket{ connectto };
allow riladapter_host riladapter_host:netlink_route_socket { create bind write read nlmsg_write };
allow riladapter_host riladapter_host:unix_dgram_socket { ioctl };
allowxperm riladapter_host tty_device:chr_file ioctl { 0x5401 0x5402 };
allowxperm riladapter_host riladapter_host:unix_dgram_socket ioctl { 0x8933 };
