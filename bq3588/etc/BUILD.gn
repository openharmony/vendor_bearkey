import("//build/ohos.gni")
foundation_daemon_out_dir = get_label_info(
    "//foundation/filemanagement/storage_service/services/storage_daemon:storage_daemon_disk_config",
    "target_out_dir")

ohos_prebuilt_etc("para_for_chip_prod") {
  source = "./param/hardware_rk3588.para"
  install_images = [ chip_prod_base_dir ]
  relative_install_dir = "param"
  part_name = "product_bq3588"
}

ohos_prebuilt_etc("para_for_sys_prod") {
  source = "./param/product_rk3588.para"
  install_images = [ sys_prod_base_dir ]
  relative_install_dir = "param"
  part_name = "product_bq3588"
}

action("storage_daemon_disk_config_override") {
  deps = [
    "//foundation/filemanagement/storage_service/services/storage_daemon:storage_daemon_disk_config",
  ]
  script = "/usr/bin/env"
  outputs = [ "$target_out_dir/disk_config_override.stamp" ]
  args = [
    "cp", "-f",
    rebase_path("disk_config", root_build_dir),
    rebase_path("${foundation_daemon_out_dir}/disk_config", root_build_dir),
  ]
}


ohos_prebuilt_etc("passwd") {
  source = "./passwd"
  install_images = [
    "system",
    "updater",
  ]
  part_name = "product_bq3588"
}

ohos_prebuilt_etc("group") {
  source = "./group"
  install_images = [
    "system",
    "updater",
  ]
  part_name = "product_bq3588"
}

group("product_etc_conf") {
  deps = [
    ":para_for_chip_prod",
    ":para_for_sys_prod",
    ":storage_daemon_disk_config_override",
    ":passwd",
    ":group",
  ]
}
